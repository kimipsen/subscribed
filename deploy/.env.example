# Copy to deploy/.env (gitignored). Non-secret endpoints only; secrets go in deploy/secrets/.
SUBSCRIBED_IMAGE=subscribed:local
SUBSCRIBED_PORT=8080
PUBLIC_ORIGIN=https://subscribed.example.invalid
# Reverse proxy address(es) or CIDR, comma separated. Empty = forwarded headers are ignored.
KNOWN_PROXIES=
OIDC_AUTHORITY=https://idp.example.invalid/realms/example
OIDC_CLIENT_ID=subscribed
# ClientId (RP-initiated logout with client_id) or None (local logout only).
OIDC_IDP_LOGOUT=ClientId
DB_SCHEMA=subscribed
DB_APP_ROLE=subscribed_app
