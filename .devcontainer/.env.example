# Copy to .env and replace placeholders. Local development only; never commit .env.
# Existing volumes retain their original credentials.
POSTGRES_USER=subscribed_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=subscribed_dev

# Local application database setup: python3 scripts/setup-database.py
# POSTGRES_* above authenticate the provisioning administrator.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SUBSCRIBED_DB=subscribed
SUBSCRIBED_SCHEMA=subscribed
SUBSCRIBED_APP_USER=subscribed_app
SUBSCRIBED_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
SUBSCRIBED_MIGRATOR_USER=subscribed_migrator
SUBSCRIBED_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD

# Keycloak bootstrap administrator, used only when its database is first initialized.
KC_BOOTSTRAP_ADMIN_USERNAME=dev-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
